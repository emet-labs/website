---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Sentinel"
	description="Runtime verification for agentic AI systems. In private development from Emet Labs."
>
	<section class="mx-auto w-full max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
		<div class="grid gap-12 lg:grid-cols-12">
			<p class="text-xs font-medium uppercase tracking-[0.16em] text-black/50 lg:col-span-3">
				Sentinel
			</p>
			<div class="max-w-3xl lg:col-span-8">
				<h1 class="font-serif text-4xl font-light tracking-[-0.045em] sm:text-5xl">
					Sentinel
				</h1>

				<p class="mt-8 text-lg leading-snug text-black/70">
					Runtime verification for agentic AI systems. It checks what a deployment
					actually did against specifications and reports the conclusion with evidence.
					In private development.
				</p>

				<p class="mt-6 text-lg leading-snug text-black/70">
					If you want to participate, {" "}
					<a href="/trace-grab" class="underline hover:no-underline">trace-grab</a>{" "}
					is the way in.
				</p>
			</div>
		</div>
	</section>
</BaseLayout>
