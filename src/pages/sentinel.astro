---
import ContactSection from '../components/ContactSection.astro';
import Rows from '../components/Rows.astro';
import Section from '../components/Section.astro';
import Sequence from '../components/Sequence.astro';
import { links } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
	{ label: 'Observe', title: 'What did it do?', note: 'Open-source instrumentation records events across your systems.' },
	{ label: 'Check', title: 'Was it allowed?', note: 'Each event is checked against rules your team defines.' },
	{ label: 'Conclude', title: 'How sure are we?', note: 'Every answer carries its evidence, or names what is missing.' },
];

const commitments = [
	{ term: 'Retraceable', body: 'Each answer links to its rule and the observations behind it.' },
	{ term: 'Explicit about gaps', body: 'Incomplete evidence is reported as inconclusive, never as a pass.' },
	{ term: 'Across systems', body: 'It reasons about the whole chain of actions, end to end.' },
	{ term: 'Rules you own', body: 'Requirements are written down and reviewed by your team.' },
	{
		term: 'Prevention where sound',
		body: 'For a narrow class of rules, it is designed to stop an action before it takes effect.',
	},
];

const status = [
	{ term: 'Sentinel', body: 'In private development. Not yet generally available.' },
	{ term: 'Instrumentation SDKs', body: 'Source published under MPL-2.0.', href: links.github, linkLabel: 'GitHub' },
	{ term: 'Documentation', body: 'Early and in progress.', href: `${links.docs}/sentinel`, linkLabel: 'Docs' },
	{ term: 'Test data', body: 'Real traces contributed through trace-grab.', href: '/trace-grab', linkLabel: 'trace-grab' },
];
---

<BaseLayout
	title="Sentinel"
	description="Sentinel is runtime verification for AI agents: it checks what a deployment did against rules you define and reports each conclusion with its evidence. In private development."
>
	<header class="wrap grid gap-12 pt-16 pb-20 sm:pt-24 lg:grid-cols-12 lg:gap-8 lg:pt-28 lg:pb-28">
		<div class="lg:col-span-6">
			<p class="text-small text-dusk">In private development</p>
			<h1 class="mt-4 text-display text-ink">Sentinel</h1>
			<p class="mt-8 max-w-md text-lede text-slate">
				Runtime verification for AI agents. It checks what a deployment did against your rules and
				shows the evidence for every answer.
			</p>
		</div>
		<div class="lg:col-span-5 lg:col-start-8 lg:self-end">
			<Sequence steps={steps} vertical />
		</div>
	</header>

	<Section label="Design commitments" tone="ink">
		<div class="grid gap-10 md:grid-cols-9 md:gap-8">
			<p class="statement md:sticky md:top-32 md:col-span-4 md:self-start">
				Built for settings where a wrong answer is worse than no&nbsp;answer.
			</p>
			<dl class="divide-y divide-white/15 border-y border-white/15 md:col-span-5">
				{
					commitments.map(({ term, body }) => (
						<div class="py-6">
							<dt class="font-display text-subhead text-white">{term}</dt>
							<dd class="mt-2 text-body text-haze">{body}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</Section>

	<Section label="Status">
		<Rows items={status} />
	</Section>

	<ContactSection lead="Do your agents take consequential actions? Tell us about it." />
</BaseLayout>
