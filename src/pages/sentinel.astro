---
import ContactLink from '../components/ContactLink';
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
	{
		title: 'Audit-admissible Verdicts',
		body: 'Every Verdict is inseparable from the evidence conditions under which it was computed — what was observed, what order is established, what is missing, and whether the conclusion is settled or Inconclusive.',
	},
	{
		title: 'Never passes on missing evidence',
		body: 'Sentinel never turns missing evidence into a pass. A Verdict stays Inconclusive until the evidence is strong enough to trust it, and says so.',
	},
	{
		title: 'Causality-aware',
		body: 'Verdicts are computed over causally ready event frontiers, not a timestamp-sorted stream. Happens-before decides order; clocks only bound completeness.',
	},
	{
		title: 'Specifications you can author',
		body: 'A bounded catalogue of parameterized, scoped Patterns — absence, existence, universality, precedence, response — with reviewed AI-assisted proposals from the artifacts you already have.',
	},
	{
		title: 'Shadow & replay',
		body: 'Warm new Specifications in Shadow against live Events. Replay retained evidence to reconstruct incidents and run regressions against what actually happened.',
	},
	{
		title: 'Bounded enforcement',
		body: 'For the safety fragment meeting five gates, the same Verdict drives a synchronous permit / deny / defer decision at the point of action. Everything else stays detection, audit, and shadow.',
	},
];

const steps = [
	{
		title: 'Observe',
		body: 'Probes sit with each monitored application and ship only the evidence your active Specifications require — a relevance projection, never a sample.',
	},
	{
		title: 'Verify',
		body: 'The Verification Core advances causally ready event frontiers against compiled Specifications. A Verdict settles only when every admissible order agrees.',
	},
	{
		title: 'Act',
		body: 'Verdicts land with their full Assurance Envelope. For the bounded safety fragment, the same Verdict drives a blocking decision; for everything else, detection, audit, and shadow.',
	},
];
---

<BaseLayout
	title="Sentinel"
	description="Causality-aware runtime verification for cross-system action sequences, with high-impact AI agents as the first target."
>
	<!-- Hero -->
	<section class="flex flex-1 items-center">
		<div class="mx-auto w-full max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
			<div class="max-w-5xl">
				<p
					class="mb-8 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.16em] text-black/60"
				>
					Sentinel
				</p>

				<h1
					class="font-serif text-6xl font-light leading-[0.92] tracking-[-0.055em] sm:text-7xl lg:text-[8.5rem]"
				>
					Runtime verification for agents that act.
				</h1>

				<p
					class="mt-8 max-w-3xl text-xl leading-snug tracking-[-0.025em] text-black/70 sm:text-2xl lg:text-3xl"
				>
					Sentinel checks what a deployment actually did against your
					Specifications — and reports both the conclusion and the evidence
					behind it.
				</p>

				<div class="mt-12">
					<ContactLink
						class="inline-flex items-center rounded-full bg-black px-6 py-3 text-sm font-medium text-white transition-opacity hover:opacity-70"
						label="Get in touch →"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Value proposition -->
	<section class="border-t border-black/10">
		<div class="mx-auto w-full max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
			<div class="grid gap-12 lg:grid-cols-12">
				<p class="text-xs font-medium uppercase tracking-[0.16em] text-black/50 lg:col-span-3">
					Why Sentinel
				</p>
				<div class="max-w-3xl lg:col-span-8">
					<p
						class="font-serif text-3xl font-light leading-snug tracking-[-0.03em] sm:text-4xl lg:text-5xl"
					>
						Enterprises are giving AI agents authority to cause irreversible
						external effects — move money, change production, contact customers,
						grant access. Each action can be locally permitted while the
						sequence is globally unsafe. Sentinel verifies the cross-system
						sequence, not just the call.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Features -->
	<section class="border-t border-black/10">
		<div class="mx-auto w-full max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
			<div class="grid gap-12 lg:grid-cols-12">
				<p class="text-xs font-medium uppercase tracking-[0.16em] text-black/50 lg:col-span-3">
					Capabilities
				</p>
				<div class="lg:col-span-9">
					<div class="grid gap-px bg-black/10 sm:grid-cols-3">
						{features.map(({ title, body }) => (
							<div class="bg-white p-8">
								<h3 class="font-serif text-xl font-light tracking-[-0.02em]">{title}</h3>
								<p class="mt-3 text-sm leading-relaxed text-black/60">{body}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- How it works -->
	<section class="border-t border-black/10">
		<div class="mx-auto w-full max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
			<div class="grid gap-12 lg:grid-cols-12">
				<p class="text-xs font-medium uppercase tracking-[0.16em] text-black/50 lg:col-span-3">
					How it works
				</p>
				<div class="max-w-3xl lg:col-span-8">
					<ol class="divide-y divide-black/10">
						{steps.map(({ title, body }, i) => (
							<li class="grid grid-cols-[auto_1fr] gap-6 py-8 first:pt-0">
								<span class="font-serif text-2xl font-light text-black/30">
									0{i + 1}
								</span>
								<div>
									<h3 class="font-serif text-2xl font-light tracking-[-0.02em]">{title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-black/60">{body}</p>
								</div>
							</li>
						))}
					</ol>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="border-t border-black/10">
		<div class="mx-auto w-full max-w-7xl px-6 py-24 text-center lg:px-10 lg:py-32">
			<h2 class="font-serif text-4xl font-light tracking-[-0.03em] sm:text-5xl lg:text-6xl">
				What can be honestly concluded about what this deployment did?
			</h2>
			<p class="mx-auto mt-6 max-w-xl text-sm leading-relaxed text-black/60">
				If you own the blast radius of an agent that can produce an irreversible
				external effect, let's talk.
			</p>
			<div class="mt-10">
				<ContactLink
					class="inline-flex items-center rounded-full bg-black px-6 py-3 text-sm font-medium text-white transition-opacity hover:opacity-70"
					label="Get in touch →"
				/>
			</div>
		</div>
	</section>
</BaseLayout>
