---
import ContactLink from '../components/ContactLink';
import BaseLayout from '../layouts/BaseLayout.astro';

// TODO: replace placeholder copy with real Sentinel positioning.
const features = [
	{
		title: 'Feature one',
		body: 'One-sentence description of the first capability.',
	},
	{
		title: 'Feature two',
		body: 'One-sentence description of the second capability.',
	},
	{
		title: 'Feature three',
		body: 'One-sentence description of the third capability.',
	},
];

const steps = [
	{ title: 'Step one', body: 'What happens first.' },
	{ title: 'Step two', body: 'What happens next.' },
	{ title: 'Step three', body: 'The outcome.' },
];
---

<BaseLayout
	title="Sentinel"
	description="Sentinel — coming soon from Emet Labs."
>
	<!-- Hero -->
	<section class="flex flex-1 items-center">
		<div class="mx-auto w-full max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
			<div class="max-w-5xl">
				<p
					class="mb-8 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.16em] text-black/60"
				>
					Sentinel
				</p>

				<h1
					class="font-serif text-6xl font-light leading-[0.92] tracking-[-0.055em] sm:text-7xl lg:text-[8.5rem]"
				>
					Headline goes here.
				</h1>

				<p
					class="mt-8 max-w-3xl text-xl leading-snug tracking-[-0.025em] text-black/70 sm:text-2xl lg:text-3xl"
				>
					Subhead positioning Sentinel in one line.
				</p>

				<div class="mt-12">
					<ContactLink
						class="inline-flex items-center rounded-full bg-black px-6 py-3 text-sm font-medium text-white transition-opacity hover:opacity-70"
						label="Get in touch →"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Value proposition -->
	<section class="border-t border-black/10">
		<div class="mx-auto w-full max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
			<div class="grid gap-12 lg:grid-cols-12">
				<p class="text-xs font-medium uppercase tracking-[0.16em] text-black/50 lg:col-span-3">
					Why Sentinel
				</p>
				<div class="max-w-3xl lg:col-span-8">
					<p
						class="font-serif text-3xl font-light leading-snug tracking-[-0.03em] sm:text-4xl lg:text-5xl"
					>
						A single paragraph stating the core problem Sentinel solves and for whom.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Features -->
	<section class="border-t border-black/10">
		<div class="mx-auto w-full max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
			<div class="grid gap-12 lg:grid-cols-12">
				<p class="text-xs font-medium uppercase tracking-[0.16em] text-black/50 lg:col-span-3">
					Capabilities
				</p>
				<div class="lg:col-span-9">
					<div class="grid gap-px bg-black/10 sm:grid-cols-3">
						{features.map(({ title, body }) => (
							<div class="bg-white p-8">
								<h3 class="font-serif text-xl font-light tracking-[-0.02em]">{title}</h3>
								<p class="mt-3 text-sm leading-relaxed text-black/60">{body}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- How it works -->
	<section class="border-t border-black/10">
		<div class="mx-auto w-full max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
			<div class="grid gap-12 lg:grid-cols-12">
				<p class="text-xs font-medium uppercase tracking-[0.16em] text-black/50 lg:col-span-3">
					How it works
				</p>
				<div class="max-w-3xl lg:col-span-8">
					<ol class="divide-y divide-black/10">
						{steps.map(({ title, body }, i) => (
							<li class="grid grid-cols-[auto_1fr] gap-6 py-8 first:pt-0">
								<span class="font-serif text-2xl font-light text-black/30">
									0{i + 1}
								</span>
								<div>
									<h3 class="font-serif text-2xl font-light tracking-[-0.02em]">{title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-black/60">{body}</p>
								</div>
							</li>
						))}
					</ol>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="border-t border-black/10">
		<div class="mx-auto w-full max-w-7xl px-6 py-24 text-center lg:px-10 lg:py-32">
			<h2 class="font-serif text-4xl font-light tracking-[-0.03em] sm:text-5xl lg:text-6xl">
				Ready when you are.
			</h2>
			<div class="mt-10">
				<ContactLink
					class="inline-flex items-center rounded-full bg-black px-6 py-3 text-sm font-medium text-white transition-opacity hover:opacity-70"
					label="Get in touch →"
				/>
			</div>
		</div>
	</section>
</BaseLayout>
