---
import ContactSection from '../components/ContactSection.astro';
import RuleExample from '../components/RuleExample.astro';
import Section from '../components/Section.astro';
import { links } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// What the evidence view below shows, in plain terms.
const callouts = [
	{ term: 'The rule', body: 'Checked by exact version. Rules are written down and reviewed by your team.' },
	{ term: 'The evidence', body: 'Each event the answer rests on, with the system it came from.' },
	{
		term: 'The gap',
		body: 'The approval was never retained, so the answer is inconclusive instead of a pass.',
	},
];

// Where things stand. Each item says what exists today, or that it is in development.
const status = [
	{
		label: 'Instrumentation SDKs',
		state: 'Published',
		body: 'Open source under MPL-2.0: TypeScript, Python, Go, JVM, .NET and Elixir.',
		href: links.github,
		linkLabel: 'GitHub',
	},
	{ label: 'Documentation', state: 'Early', body: 'In progress, alongside the product.', href: `${links.docs}/sentinel`, linkLabel: 'Docs' },
	{
		label: 'Prevention',
		state: 'In development',
		body: 'For a narrow class of rules, stopping an action before it takes effect.',
	},
	{
		label: 'Real-world data',
		state: 'Open to contributors',
		body: 'Teams can contribute traces from their own agents.',
		href: '/trace-grab/',
		linkLabel: 'trace-grab',
	},
];

---

<BaseLayout
	title="Sentinel"
	description="Sentinel checks what AI agents did against rules your team sets, and reports each answer with its evidence. In private development."
	footerEmail={false}
>
	<header class="wrap pt-14 sm:pt-20 lg:pt-24">
		<p class="meta inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 text-dusk">
			<span class="size-1.5 rounded-full bg-dusk" aria-hidden="true"></span>In private development
		</p>
		<div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-8">
			<h1 class="text-hero text-ink lg:col-span-6">Sentinel</h1>
			<p class="text-lede text-slate lg:col-span-5 lg:col-start-8 lg:pb-3">
				Runtime verification for AI agents. Your team sets the rules; Sentinel checks what your agents
				did against them, and shows the evidence behind each answer.
			</p>
		</div>
	</header>

	<figure class="wrap mt-12 sm:mt-16">
		<div class="rounded-md bg-mist p-2 sm:p-5 lg:p-8">
			<img
				src="/product/sentinel-verdicts.webp"
				width="2200"
				height="962"
				alt="The Sentinel dashboard's Verdicts list: eight answers for three refund rules, marked Satisfy, Violate or Inconclusive."
				class="block h-auto w-full rounded-[4px] border border-line shadow-[0_1px_2px_rgb(26_28_39/0.06),0_12px_32px_-12px_rgb(26_28_39/0.18)]"
				decoding="async"
				fetchpriority="high"
			/>
		</div>
		<figcaption class="meta mt-3 text-dusk">Sentinel dashboard, in development, shown with sample data.</figcaption>
	</figure>

	<Section index="01" label="One rule, three answers">
		<div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
			<p class="statement lg:col-span-4">
				The same rule, checked against three records. <span class="quiet">“Not yet known” is an answer too.</span>
			</p>
			<div class="lg:col-span-7 lg:col-start-6">
				<RuleExample />
			</div>
		</div>
	</Section>

	<Section index="02" label="An answer, with its evidence" tone="panel">
		<div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
			<div class="lg:col-span-4">
				<p class="statement">Built for settings where a wrong answer is worse than no&nbsp;answer.</p>
				<ol class="mt-10 space-y-6">
					{
						callouts.map(({ term, body }, i) => (
							<li class="grid grid-cols-[1.75rem_1fr] gap-3 border-t border-rule pt-4">
								<span class="meta pt-0.5 text-ember-light">{String(i + 1).padStart(2, '0')}</span>
								<p class="text-small text-haze">
									<span class="font-medium text-white">{term}.</span> {body}
								</p>
							</li>
						))
					}
				</ol>
			</div>
			<figure class="relative sm:pb-6 lg:col-span-8">
				<img
					src="/product/sentinel-missing-evidence.webp"
					width="1400"
					height="996"
					alt="A Sentinel verdict marked Inconclusive: the rule refund-requires-approval, the events it rests on, and an approval event that was never retained."
					class="block h-auto w-full rounded-[4px]"
					loading="lazy"
					decoding="async"
				/>
				<img
					src="/product/sentinel-coverage.webp"
					width="768"
					height="170"
					alt="Evidence coverage: two of three required sources, one gap."
					class="mt-3 block h-auto w-full max-w-sm rounded-[4px] shadow-[0_18px_40px_-12px_rgb(0_0_0/0.55)] sm:absolute sm:right-4 sm:-bottom-8 sm:mt-0 sm:w-[52%] lg:-right-6"
					loading="lazy"
					decoding="async"
				/>
				<figcaption class="meta mt-4 text-haze sm:mt-5 sm:max-w-[42%]">Sentinel dashboard, in development, shown with sample data.</figcaption>
			</figure>
		</div>
	</Section>

	<Section index="03" label="Where it stands">
		<ul class="ticks grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-4">
			{
				status.map(({ label, state, body, href, linkLabel }) => (
					<li class="flex flex-col bg-paper p-6">
						<p class="meta text-dusk">{state}</p>
						<p class="mt-8 font-display text-subhead text-ink">{label}</p>
						<p class="mt-2 text-small text-slate">{body}</p>
						{href && (
							<a
								href={href}
								class="link mt-auto inline-flex min-h-11 items-center self-start pt-4 text-small font-medium text-ink"
								target={href.startsWith('http') ? '_blank' : undefined}
								rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
							>
								{linkLabel} {href.startsWith('http') ? '↗' : '→'}
								{href.startsWith('http') && <span class="sr-only"> (opens in a new tab)</span>}
							</a>
						)}
					</li>
				))
			}
		</ul>
	</Section>

	<ContactSection lead="Do your agents take consequential actions?" follow="Tell us about them." />
</BaseLayout>
