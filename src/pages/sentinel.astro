---
import ContactLink from '../components/ContactLink';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Sentinel"
	description="Sentinel — coming soon from Emet Labs."
>
	<section class="mx-auto w-full max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
		<div class="grid gap-12 lg:grid-cols-12">
			<p class="text-xs font-medium uppercase tracking-[0.16em] text-black/50 lg:col-span-3">
				Sentinel
			</p>
			<div class="max-w-3xl lg:col-span-8">
				<h1 class="font-serif text-5xl font-light tracking-[-0.045em] sm:text-7xl">
					Coming Soon
				</h1>
				<ContactLink class="mt-10 inline-flex text-sm font-medium underline hover:no-underline" />
			</div>
		</div>
	</section>
</BaseLayout>
