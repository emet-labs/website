---
import Button from '../components/Button.astro';
import ContactSection from '../components/ContactSection.astro';
import Section from '../components/Section.astro';
import StoryTrace from '../components/StoryTrace.astro';
import TraceField from '../components/TraceField.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const work = [
	{
		href: '/sentinel/',
		title: 'Sentinel',
		status: 'In private development',
		body: 'Runtime verification for AI agents: rules your team sets, checked against what happened.',
	},
	{
		href: '/research/',
		title: 'Research',
		status: 'Ongoing',
		body: 'Open problems in specifying, observing and checking systems that act on their own.',
	},
	{
		href: '/trace-grab/',
		title: 'trace-grab',
		status: 'Open source · Apache-2.0',
		body: 'A tool for contributing agent traces without sharing the sensitive values inside them.',
	},
];
---

<BaseLayout footerEmail={false}>
	<header class="wrap pt-14 sm:pt-20 lg:pt-24">
		<div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-8">
			<h1 class="text-hero text-ink lg:col-span-8">Know what your agents&nbsp;did.</h1>
			<div class="lg:col-span-4 lg:pb-2">
				<p class="text-lede text-slate">
					Emet Labs builds verification infrastructure for AI agents, so that what they did can be
					checked against the rules they were given.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-2">
					<Button href="/sentinel/">See how Sentinel answers</Button>
					<a href="/research/" class="link inline-flex min-h-11 items-center text-small font-medium">Our research</a>
				</div>
			</div>
		</div>
	</header>

	<div class="wrap mt-12 sm:mt-16">
		<div class="tone-ink overflow-hidden rounded-md bg-ink px-5 pt-6 pb-5 text-white sm:px-8 sm:pt-8 lg:px-10">
			<TraceField />
		</div>
	</div>

	<section class="wrap py-20 sm:py-28 lg:py-32">
		<p class="max-w-5xl font-display text-[length:var(--text-title)] leading-[1.12] tracking-[-0.015em] text-ink text-balance">
			Agents now act on their own.{' '}
			<span class="quiet">
				We build the means to check what they did against the rules people set, and to say plainly
				when the evidence is not enough.
			</span>
		</p>
	</section>

	<Section index="01" label="Why it is hard to know">
		<StoryTrace />
	</Section>

	<Section index="02" label="What we work on">
		<ul class="ticks grid gap-px bg-line md:grid-cols-3">
			{
				work.map(({ href, title, status, body }) => (
					<li class="bg-paper">
						<a href={href} class="group flex h-full flex-col p-6 transition-colors hover:bg-mist sm:p-8">
							<span class="meta text-dusk">{status}</span>
							<span class="mt-10 font-display text-headline text-ink sm:mt-16">{title}</span>
							<span class="mt-3 text-small text-slate">{body}</span>
							<span aria-hidden="true" class="mt-8 text-ink transition-transform duration-200 group-hover:translate-x-1">
								→
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</Section>

	<ContactSection />
</BaseLayout>
