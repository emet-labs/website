---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<section class="flex flex-1 items-center">
		<div class="mx-auto w-full max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
			<div class="max-w-3xl">
				<h1 class="font-serif text-4xl font-light leading-[0.95] tracking-[-0.045em] sm:text-5xl">
					Emet Labs.
				</h1>

				<p class="mt-6 text-lg leading-snug tracking-[-0.025em] text-black/70 sm:text-xl">
					Runtime verification and AI security.
				</p>

				<div class="mt-10">
					<a href="/trace-grab" class="text-sm font-medium underline hover:no-underline">
						Help us study traces →
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
