---
import Button from '../components/Button.astro';
import ContactSection from '../components/ContactSection.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const problem = [
	'Agents now call tools, move money and change records.',
	'Each action spans systems that keep separate, partial logs.',
	'A model’s account of what it did is not evidence.',
];

const work = [
	{ href: '/sentinel/', title: 'Sentinel', body: 'Runtime verification for AI agents. In private development.' },
	{ href: '/research/', title: 'Research', body: 'Open problems in verifying systems that act on their own.' },
	{ href: '/trace-grab/', title: 'trace-grab', body: 'Open-source tool for contributing tokenized traces.' },
];
---

<BaseLayout footerEmail={false}>
	<header class="wrap pt-16 pb-20 sm:pt-24 lg:pt-32 lg:pb-32">
		<h1 class="text-display text-ink">Know what your agents&nbsp;did.</h1>
		<div class="mt-8 grid gap-8 sm:mt-12 lg:grid-cols-12">
			<div class="lg:col-span-6 lg:col-start-4">
				<p class="max-w-xl text-lede text-slate">
					Emet Labs builds verification infrastructure for AI agents, so that what they did can be
					checked against the rules they were given.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-2">
					<Button href="/sentinel/">See how Sentinel answers</Button>
					<a href="/research/" class="link inline-flex min-h-11 items-center text-small font-medium">See our research</a>
				</div>
			</div>
			<p class="max-w-xs text-small text-dusk lg:col-span-3 lg:row-start-1 lg:pt-1.5">
				Sentinel is in private development. <span class="whitespace-nowrap">trace-grab</span> is open source under Apache-2.0.
			</p>
		</div>
	</header>

	<Section label="Why it is hard to know" tone="ink">
		<ul class="space-y-8 sm:space-y-10">
			{problem.map((line) => <li class="statement">{line}</li>)}
		</ul>
	</Section>

	<Section label="What we work on">
		<ul class="divide-y divide-line">
			{
				work.map(({ href, title, body }) => (
					<li>
						<a
							href={href}
							class="group grid gap-1 py-7 md:grid-cols-9 md:items-baseline md:gap-8"
						>
							<span class="font-display text-headline text-ink underline decoration-transparent underline-offset-[0.2em] transition-colors group-hover:decoration-current md:col-span-3">{title}</span>
							<span class="text-body text-slate md:col-span-5">{body}</span>
							<span
								aria-hidden="true"
								class="hidden text-right text-ink transition-transform duration-200 group-hover:translate-x-1 md:block"
							>
								→
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</Section>

	<ContactSection lead="Building agents that take consequential actions? We would like to hear from you." />
</BaseLayout>
