---
import Button from '../components/Button.astro';
import ContactSection from '../components/ContactSection.astro';
import Section from '../components/Section.astro';
import StoryTrace from '../components/StoryTrace.astro';
import TraceField from '../components/TraceField.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const work = [
	{
		href: '/research/',
		title: 'Research',
		status: 'Ongoing',
		body: 'What runtime verification is, how it works, and the open problems it meets in agents.',
	},
	{
		href: '/trace-grab/',
		title: 'Help us study traces',
		status: 'Research data · Apache-2.0',
		body: 'Collecting agent traces for specification-inference research, without their string values.',
	},
];
---

<BaseLayout footerEmail={false}>
	<header class="wrap pt-16 sm:pt-24 lg:pt-28">
		<h1 class="max-w-3xl text-hero text-ink">Verify what your software&nbsp;did.</h1>
		<div class="mt-8 flex flex-col gap-8 sm:mt-10 lg:flex-row lg:items-end lg:justify-between">
			<p class="max-w-xl text-lede text-slate">
				Emet Labs builds <a href="/research/#rv" class="link">runtime verification</a>: formal rules for your services,
				applications and AI agents, checked against what happened.
			</p>
			<div class="flex flex-wrap items-center gap-x-7 gap-y-3">
				<Button href="/sentinel/">See how Sentinel answers</Button>
				<a href="/research/" class="link inline-flex min-h-11 items-center text-small font-medium">Our research</a>
			</div>
		</div>
	</header>

	<div class="wrap mt-12 sm:mt-16 lg:mt-20">
		<div class="tone-ink overflow-hidden rounded-md bg-ink px-5 pt-6 pb-5 text-white sm:px-8 sm:pt-8 lg:px-10">
			<TraceField />
		</div>
	</div>

	<section class="wrap pt-20 pb-8 sm:pt-28 sm:pb-12 lg:pt-32 lg:pb-12">
		<p class="max-w-4xl font-display text-[length:var(--text-title)] leading-[1.18] tracking-[-0.01em] text-ink text-balance">
			Agents now act on their own.{' '}
			<span class="quiet">
				We check what they did against formal rules that people set, and we say plainly when the
				evidence is not enough.
			</span>
		</p>
	</section>

	<Section label="Why it is hard to know">
		<StoryTrace />
	</Section>

	<Section label="What we work on">
		<a href="/sentinel/" class="group grid overflow-hidden rounded-md bg-mist lg:grid-cols-12">
			<div class="flex flex-col p-6 sm:p-10 lg:col-span-5 lg:p-12">
				<span class="meta text-dusk">In private development</span>
				<span class="mt-10 font-display text-[length:var(--text-title)] leading-none text-ink">Sentinel</span>
				<span class="mt-6 max-w-sm text-body text-slate">
					Integrated runtime verification across your services, applications and agents: rules your team sets,
					checked against what happened, with the evidence behind each answer.
				</span>
				<span class="mt-8 inline-flex items-center gap-2 text-small font-medium text-ink lg:mt-auto lg:pt-10">
					See how Sentinel answers
					<span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
				</span>
			</div>
			<div class="relative min-h-64 overflow-hidden pl-6 sm:pl-10 lg:col-span-7 lg:min-h-0 lg:pt-12 lg:pl-0">
				<picture>
					<source media="(max-width: 39.99rem)" srcset="/product/sentinel-verdicts-mobile.webp" width="900" height="1176" />
					<img
						src="/product/sentinel-verdicts.webp"
						width="2200"
						height="962"
						alt=""
						class="absolute top-6 left-6 w-[115%] max-w-none rounded-tl-(--radius-frame) border-t border-l border-line shadow-(--shadow-frame) sm:left-10 sm:w-[190%] lg:top-12 lg:left-0 lg:w-[150%]"
						loading="lazy"
						decoding="async"
					/>
				</picture>
			</div>
		</a>

		<ul class="mt-10 border-t border-line">
			{
				work.map(({ href, title, status, body }) => (
					<li class="border-b border-line">
						<a href={href} class="group grid gap-2 py-7 md:grid-cols-12 md:items-baseline md:gap-8">
							<span class="font-display text-headline text-ink md:col-span-4">{title}</span>
							<span class="text-small text-slate md:col-span-4">{body}</span>
							<span class="meta text-dusk md:col-span-3 md:whitespace-nowrap">{status}</span>
							<span aria-hidden="true" class="hidden text-right text-ink transition-transform duration-200 group-hover:translate-x-1 md:block">
								→
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</Section>

	<ContactSection />
</BaseLayout>
