---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Blog" description="Notes and updates from Emet Labs.">
	<section class="mx-auto w-full max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
		<div class="grid gap-12 lg:grid-cols-12">
			<p class="text-xs font-medium uppercase tracking-[0.16em] text-black/50 lg:col-span-3">
				Blog
			</p>
			<div class="max-w-3xl lg:col-span-8">
				<h1 class="font-serif text-5xl font-light tracking-[-0.045em] sm:text-7xl">
					Notes from Emet Labs.
				</h1>
				<div class="mt-16 border-t border-black/15 py-8">
					<p class="text-sm text-black/50">No posts yet.</p>
					<p class="mt-3 text-lg tracking-[-0.015em]">
						Research, technical notes, and company updates are coming soon.
					</p>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
