---
import ContactSection from '../components/ContactSection.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const differences = [
	{ term: 'Not fixed in advance', body: 'The same task can take a different path each time.' },
	{ term: 'Distributed', body: 'Work fans out across services whose clocks disagree.' },
	{ term: 'Partially observed', body: 'Telemetry is sampled, delayed and sometimes lost.' },
	{ term: 'Self-reported', body: 'An agent’s own log is a weak witness to its actions.' },
];

const questions = [
	{ area: 'Specification', question: 'How should people state what an agent may do, precisely and readably?' },
	{ area: 'Sound conclusions', question: 'When is evidence enough for a verdict, and how do you say it is not?' },
	{ area: 'Causality', question: 'What led to what, across systems with no common clock?' },
	{ area: 'Intervention', question: 'Which rules can be enforced before an action without blocking legitimate work?' },
	{
		area: 'Responsible data',
		question: 'How do you learn from production traces without collecting their contents?',
		href: '/trace-grab',
		linkLabel: 'See trace-grab',
	},
];
---

<BaseLayout
	title="Research"
	description="The research behind Emet Labs: runtime verification for autonomous AI agents, and the open questions in specifying, observing and controlling systems that act on their own."
>
	<PageHeader title="Verification for systems that act on their own.">
		<p>
			Runtime verification checks a system’s behaviour against a precise specification as it runs.
			Autonomous agents strain its assumptions. Our research addresses that gap.
		</p>
	</PageHeader>

	<Section label="Why agents are different">
		<dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2">
			{
				differences.map(({ term, body }) => (
					<div class="border-t border-ink pt-5">
						<dt class="font-display text-subhead text-ink">{term}</dt>
						<dd class="mt-2 max-w-xs text-body text-slate">{body}</dd>
					</div>
				))
			}
		</dl>
	</Section>

	<Section label="Open questions">
		<ol class="divide-y divide-line border-y border-line">
			{
				questions.map(({ area, question, href, linkLabel }, i) => (
					<li class="grid gap-2 py-7 md:grid-cols-9 md:gap-8">
						<p class="label md:col-span-2 md:pt-1.5">
							<span class="mr-2 tabular-nums" aria-hidden="true">{i + 1}</span>
							{area}
						</p>
						<div class="md:col-span-7">
							<h3 class="text-subhead text-ink">{question}</h3>
							{href && (
								<a href={href} class="link mt-3 inline-block text-small font-medium">
									{linkLabel} →
								</a>
							)}
						</div>
					</li>
				))
			}
		</ol>
	</Section>

	<Section label="Foundations">
		<p class="statement max-w-3xl">
			We build on runtime verification and the monitoring of distributed systems, and prefer guarantees
			that can be stated&nbsp;precisely.
		</p>
	</Section>

	<ContactSection lead="Working on related problems? We would be glad to compare notes." />
</BaseLayout>
