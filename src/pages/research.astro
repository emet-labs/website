---
import ContactSection from '../components/ContactSection.astro';
import PageHeader from '../components/PageHeader.astro';
import Rows from '../components/Rows.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const differences = [
	{
		term: 'Behaviour is not fixed',
		body: 'The same agent, given the same task, may take a different path each time. Testing before deployment cannot enumerate every behaviour, so some guarantees have to be established while the system runs.',
	},
	{
		term: 'Work is distributed',
		body: 'Agents hand off to one another, fan out and act in parallel across services whose clocks disagree. The order in which events were logged is not always the order in which they happened.',
	},
	{
		term: 'Observation is partial',
		body: 'Telemetry is sampled, delayed and sometimes lost. A sound conclusion has to account for what was not seen, not only for what was.',
	},
	{
		term: 'Self-report is weak',
		body: 'An agent’s account of its own actions is a poor witness to them. Records from the systems it acted on carry more weight than its own narration.',
	},
];

const questions = [
	{
		area: 'Specification',
		question:
			'How should people state what an agent may and may not do, precisely enough for a machine to check and plainly enough for a reviewer to approve?',
	},
	{
		area: 'Sound conclusions',
		question: 'When is the available evidence sufficient to reach a verdict, and how should a system say clearly that it is not?',
	},
	{
		area: 'Ordering and causality',
		question: 'How do you establish what led to what across systems that share no common clock?',
	},
	{
		area: 'Intervention',
		question:
			'Which rules can be enforced before an action takes effect without obstructing legitimate work, and which are better observed and reviewed?',
	},
	{
		area: 'Responsible data',
		question: 'How do you learn from real production behaviour without collecting the sensitive content inside it?',
		href: '/trace-grab',
		linkLabel: 'This is why we built trace-grab',
	},
];
---

<BaseLayout
	title="Research"
	description="The research behind Emet Labs: runtime verification for autonomous AI agents, and the open questions in specifying, observing and controlling systems that act on their own."
>
	<PageHeader title="Verification for systems that act on their own.">
		<p>
			Runtime verification, the practice of checking a system’s actual behaviour against a precise
			specification as it runs, is a mature field. Autonomous agents strain several of its
			assumptions. Our research is about closing that gap.
		</p>
	</PageHeader>

	<Section label="Why agents are different">
		<Rows items={differences} />
	</Section>

	<Section label="Open questions">
		<ul class="space-y-12">
			{
				questions.map(({ area, question, href, linkLabel }) => (
					<li class="max-w-3xl">
						<p class="label">{area}</p>
						<h3 class="mt-3 text-subhead text-ink">{question}</h3>
						{href && (
							<a href={href} class="link mt-3 inline-block text-small font-medium">
								{linkLabel} →
							</a>
						)}
					</li>
				))
			}
		</ul>
	</Section>

	<Section label="Foundations">
		<div class="measure space-y-5 text-lede text-slate">
			<p>
				Our approach draws on established work in runtime verification, temporal specification and the
				monitoring of concurrent and distributed systems.
			</p>
			<p>
				We prefer methods whose guarantees can be stated precisely over heuristics whose failures are
				hard to see, and we treat a clear “not yet known” as a better outcome than a confident guess.
			</p>
		</div>
	</Section>

	<ContactSection lead="If you work on related problems, in research or in production, we would be glad to compare notes." />
</BaseLayout>
