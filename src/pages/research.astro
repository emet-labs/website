---
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// Each open question, with the property of agents that makes it hard.
const questions = [
	{
		question: 'How should people state what an agent may do, precisely and readably?',
		why: 'The same task can take a different path each time, so rules cannot list every path in advance.',
	},
	{
		question: 'When is evidence enough for a verdict, and how do you say it is not?',
		why: 'Telemetry is sampled, delayed and sometimes lost, and an agent’s own log is a weak witness.',
	},
	{
		question: 'What led to what, across systems with no common clock?',
		why: 'One task fans out across services whose clocks disagree.',
	},
	{
		question: 'Which rules can be enforced before an action without blocking legitimate work?',
		why: 'Some actions cannot be undone.',
	},
	{
		question: 'How do you learn from production traces without collecting the sensitive values inside them?',
		why: 'Real traces are what a verifier has to handle, and they carry customer data.',
		href: '/trace-grab/',
		linkLabel: 'See trace-grab',
	},
];
---

<BaseLayout
	title="Research"
	description="The research behind Emet Labs: runtime verification for autonomous AI agents, and the open questions in specifying, observing and controlling systems that act on their own."
>
	<PageHeader title="Verification for systems that act on their own.">
		<p>
			Runtime verification checks a running system against a precise specification. Autonomous agents
			strain its assumptions. These are the questions we are working on.
		</p>
	</PageHeader>

	<div class="wrap">
		<ol aria-label="Open questions" class="divide-y divide-line border-y border-line">
			{
				questions.map(({ question, why, href, linkLabel }, i) => (
					<li class="grid gap-3 py-10 sm:py-12 lg:grid-cols-12 lg:gap-8">
						<p aria-hidden="true" class="font-display text-headline text-dusk tabular-nums lg:col-span-3">
							{String(i + 1).padStart(2, '0')}
						</p>
						<div class="measure lg:col-span-7 lg:col-start-4">
							<h2 class="text-headline text-ink">{question}</h2>
							<p class="mt-4 text-body text-slate">{why}</p>
							{href && (
								<a href={href} class="link mt-4 inline-flex min-h-11 items-center text-small font-medium text-ink">
									{linkLabel} →
								</a>
							)}
						</div>
					</li>
				))
			}
		</ol>
	</div>

	<Section label="Foundations">
		<p class="statement measure">
			We build on runtime verification and the monitoring of distributed systems, and prefer guarantees
			that can be stated&nbsp;precisely.
		</p>
	</Section>
</BaseLayout>
