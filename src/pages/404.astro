---
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
	<PageHeader eyebrow="404" title="Not yet known.">
		<p>There is no page at this address. It may have moved, or the link may be wrong.</p>
		<p class="mt-6 text-small">
			<a href="/" class="link text-ink">Go to the homepage →</a>
		</p>
	</PageHeader>
</BaseLayout>
