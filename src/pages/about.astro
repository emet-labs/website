---
import ContactSection from '../components/ContactSection.astro';
import PageHeader from '../components/PageHeader.astro';
import Rows from '../components/Rows.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const principles = [
	{
		term: 'Claims you can check',
		body: 'We state what our tools do in a form you can verify, as trace-grab does for each of its privacy claims.',
	},
	{ term: 'Explicit about uncertainty', body: 'We report a gap rather than paper over it, in software and in prose.' },
	{
		term: 'Open where trust requires it',
		body: 'Software that runs in your environment should be open to inspection, so trace-grab and our SDKs are.',
	},
];
---

<BaseLayout
	title="About"
	description="Emet Labs is a research and engineering company building verification infrastructure for AI agents."
>
	<PageHeader title="We build the means to check what autonomous systems do.">
		<p>Emet Labs is a research and engineering company working on verification for AI agents.</p>
	</PageHeader>

	<Section label="Why this work">
		<p class="statement max-w-3xl">A mistaken answer can be ignored. A mistaken payment&nbsp;cannot.</p>
		<p class="measure mt-6 text-body text-slate">
			As agents take actions, organisations need to show what happened and whether it was allowed. We
			think that belongs in the infrastructure, not in a reconstruction after the fact.
		</p>
	</Section>

	<Section label="How we work">
		<Rows items={principles} />
	</Section>

	<ContactSection lead="We are glad to talk with engineers, researchers and teams deploying agents." channels />
</BaseLayout>
