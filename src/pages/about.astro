---
import ContactSection from '../components/ContactSection.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Founder {
	name: string;
	role: string;
	/** What the person studies or has built. Short and factual. */
	bio: string;
	/** Optional. Path under /public, for example /team/name.webp. Square, at least 640px. */
	photo?: string;
	links?: { label: string; href: string }[];
}

const founders: Founder[] = [
	{
		name: 'Abhishek Pujara',
		role: 'Cofounder',
		bio: 'Studies mathematics and computer science at Northeastern University.',
	},
	{
		name: 'Arnab Ghosh',
		role: 'Cofounder',
		bio: 'Studies mathematics and computer science at Cornell University.',
		links: [{ label: 'arnabg.me', href: 'https://www.arnabg.me' }],
	},
	{
		name: 'Smyan Sengupta',
		role: 'Cofounder',
		bio: 'Studies mathematics and computer science at Northeastern University.',
		links: [{ label: 'smyan.dev', href: 'https://www.smyan.dev' }],
	},
];
---

<BaseLayout
	title="About"
	description="Emet Labs is a research and engineering company building verification infrastructure for AI agents."
	footerEmail={false}
>
	<header class="wrap pt-16 pb-16 sm:pt-24 sm:pb-24 lg:pt-28">
		<h1 class="text-hero text-ink">About</h1>
		<p class="statement mt-8 max-w-2xl sm:mt-10">
			A mistaken answer can be ignored. <span class="quiet">A mistaken payment cannot.</span>
		</p>
	</header>

	<div class="wrap grid gap-14 pb-8 sm:pb-12 lg:grid-cols-12 lg:gap-8">
		<div class="measure text-lede text-slate lg:order-last lg:col-span-6 lg:col-start-4">
			<p>
				Emet Labs is a research and engineering company building runtime verification infrastructure for
				services, applications and AI agents.
			</p>
			<p class="mt-6">
				Our field is <a href="/research/#rv" class="link text-ink">runtime verification</a>. A monitor
				checks what a system did against a rule written in logic. A verdict names its evidence, and
				says so when the evidence is not enough.
			</p>
			<p class="mt-6">
				As agents start to take actions with consequences, the people responsible for them need a record
				they can check. We think that record belongs in the infrastructure, not in the agent’s own
				account.
			</p>
		</div>

		<dl class="grid gap-6 text-small sm:grid-cols-2 lg:col-span-3 lg:grid-cols-1 ticks border border-line p-6 lg:border-x-0 lg:border-b-0 lg:bg-none lg:px-0">
			<div>
				<dt class="meta text-dusk">Work</dt>
				<dd class="mt-1 text-ink">
					<a href="/sentinel/" class="link">Sentinel</a>, <a href="/research/" class="link">research</a>{' '}
					and <a href="/trace-grab/" class="link">trace sharing</a>
				</dd>
			</div>
			<div>
				<dt class="meta text-dusk">Open source</dt>
				<dd class="mt-1 text-slate">Code that runs inside your systems: trace-grab and our instrumentation SDKs.</dd>
			</div>
			<div>
				<dt class="meta text-dusk">Careers</dt>
				<dd class="mt-1 text-ink"><a href="/careers/" class="link inline-flex min-h-11 items-center">Work with us</a></dd>
			</div>
		</dl>
	</div>

	<Section id="founders" label="Founders">
		<div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
			<p class="statement lg:col-span-4">
				Three cofounders.{' '}
				<span class="quiet">Mathematics and computer science.</span>
			</p>
			<ul class="ticks grid gap-px bg-line sm:grid-cols-3 lg:col-span-8 lg:col-start-5">
				{
					founders.map(({ name, role, bio, photo, links: profile }) => (
						<li class="flex flex-col bg-paper p-6">
							{photo && (
								<img
									src={photo}
									alt=""
									width="640"
									height="640"
									loading="lazy"
									decoding="async"
									class="mb-6 aspect-square w-full rounded-frame border border-line object-cover"
								/>
							)}
							<p class="meta text-dusk">{role}</p>
							<h3 class="mt-6 text-subhead text-ink">{name}</h3>
							<p class="mt-3 text-small text-slate">{bio}</p>
							{profile && profile.length > 0 ? (
								<p class="mt-auto flex flex-wrap gap-x-5 pt-4 text-small font-medium">
									{profile.map(({ label, href }) => (
										<a href={href} class="link inline-flex min-h-11 items-center text-ink" target="_blank" rel="noopener noreferrer">
											{label} ↗<span class="sr-only"> (opens in a new tab)</span>
										</a>
									))}
								</p>
							) : (
								<span class="mt-auto block pt-4" />
							)}
						</li>
					))
				}
			</ul>
		</div>
	</Section>

	<ContactSection lead="Engineers, researchers and teams that deploy agents." follow="Talk to us." channels />
</BaseLayout>
