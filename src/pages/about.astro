---
import ContactBand from '../components/ContactBand.astro';
import PageHeader from '../components/PageHeader.astro';
import { links, site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const principles = [
	{
		title: 'We make claims that can be checked.',
		body: 'Where we say something about our tools, we try to say it in a form you can verify yourself. trace-grab’s privacy claims, for example, each come with a way to confirm them in the source.',
	},
	{
		title: 'We are explicit about uncertainty.',
		body: 'Systems that hide what they do not know produce false confidence. We would rather report an honest gap than paper over it, in our products and in how we describe them.',
	},
	{
		title: 'We open source what others need to trust.',
		body: 'Software that runs inside someone else’s environment, handling their data, should be open to inspection. trace-grab and our instrumentation SDKs are published for that reason.',
	},
];

const work = [
	{ href: '/sentinel', title: 'Sentinel', body: 'Runtime verification for AI agents. In private development.' },
	{ href: '/research', title: 'Research', body: 'The open problems in verifying systems that act on their own.' },
	{ href: '/trace-grab', title: 'trace-grab', body: 'An open-source tool for contributing sanitized traces to that research.' },
];
---

<BaseLayout
	title="About"
	description="Emet Labs is a research and engineering company building verification infrastructure for AI agents."
>
	<PageHeader eyebrow="About" title="We build the means to check what autonomous systems do.">
		<p>Emet Labs is a research and engineering company building verification infrastructure for AI agents.</p>
	</PageHeader>

	<section>
		<div class="wrap grid gap-10 py-20 sm:py-28 lg:grid-cols-12">
			<p class="eyebrow lg:col-span-3 lg:pt-3">Why this work</p>
			<div class="space-y-6 text-lede text-slate lg:col-span-7">
				<p>
					As AI systems move from producing text to taking actions, the cost of being wrong changes. A
					mistaken answer can be ignored. A mistaken payment, deletion or disclosure cannot.
				</p>
				<p>
					Organisations that deploy agents need to know what those agents did, whether it was
					permitted, and how strong the evidence is, and they need to be able to show that to the
					people they answer to. We think that kind of accountability should be built into the
					infrastructure rather than reconstructed after the fact.
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-line bg-mist">
		<div class="wrap grid gap-10 py-20 sm:py-28 lg:grid-cols-12">
			<p class="eyebrow lg:col-span-3 lg:pt-3">How we work</p>
			<ul class="space-y-10 lg:col-span-9">
				{
					principles.map(({ title, body }) => (
						<li class="grid gap-3 border-t border-line pt-8 md:grid-cols-9 md:gap-8">
							<h2 class="text-subhead text-ink md:col-span-4">{title}</h2>
							<p class="text-body text-slate md:col-span-5">{body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="border-t border-line">
		<div class="wrap grid gap-10 py-20 sm:py-28 lg:grid-cols-12">
			<p class="eyebrow lg:col-span-3 lg:pt-3">Our work</p>
			<ul class="grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-3 lg:col-span-9">
				{
					work.map(({ href, title, body }) => (
						<li class="bg-paper">
							<a href={href} class="group flex h-full flex-col p-7 transition-colors hover:bg-mist">
								<h2 class="text-subhead text-ink">{title}</h2>
								<p class="mt-3 flex-1 text-small text-slate">{body}</p>
								<span class="mt-6 text-small font-medium text-ink" aria-hidden="true">
									<span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="border-t border-line">
		<div class="wrap grid gap-10 py-20 sm:py-28 lg:grid-cols-12">
			<p class="eyebrow lg:col-span-3 lg:pt-3">Contact</p>
			<dl class="grid gap-8 sm:grid-cols-3 lg:col-span-9">
				<div>
					<dt class="text-small text-dusk">Email</dt>
					<dd class="mt-2"><a href={links.email} class="link text-ink">{site.email}</a></dd>
				</div>
				<div>
					<dt class="text-small text-dusk">LinkedIn</dt>
					<dd class="mt-2">
						<a href={links.linkedin} class="link text-ink" target="_blank" rel="noopener noreferrer">
							Emet Labs<span class="sr-only"> (opens in a new tab)</span>
						</a>
					</dd>
				</div>
				<div>
					<dt class="text-small text-dusk">GitHub</dt>
					<dd class="mt-2">
						<a href={links.github} class="link text-ink" target="_blank" rel="noopener noreferrer">
							emet-labs<span class="sr-only"> (opens in a new tab)</span>
						</a>
					</dd>
				</div>
			</dl>
		</div>
	</section>

	<ContactBand />
</BaseLayout>
