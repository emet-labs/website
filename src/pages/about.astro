---
import { links, site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<BaseLayout
	title="About"
	description="Emet Labs is a research and engineering company building verification infrastructure for AI agents."
	footerEmail={false}
>
	<header class="wrap pt-16 pb-14 sm:pt-24 sm:pb-20 lg:pt-28">
		<h1 class="max-w-4xl text-display text-ink">
			A mistaken answer can be ignored. A mistaken payment&nbsp;cannot.
		</h1>
	</header>

	<div class="wrap grid gap-12 pb-20 sm:pb-28 lg:grid-cols-12 lg:gap-8">
		<div class="measure text-lede text-slate lg:order-last lg:col-span-6 lg:col-start-4">
			<p>
				Emet Labs is a research and engineering company building verification infrastructure for AI
				agents.
			</p>
			<p class="mt-6">
				As agents start to take actions with consequences, the people responsible for them need a record
				they can check. We think that record belongs in the infrastructure, not in the agent’s own
				account.
			</p>
		</div>

		<dl class="grid gap-6 text-small sm:grid-cols-2 lg:col-span-3 lg:grid-cols-1 lg:border-t lg:border-line lg:pt-6">
			<div>
				<dt class="label">Work</dt>
				<dd class="mt-1 text-ink">
					<a href="/sentinel/" class="link">Sentinel</a>, <a href="/research/" class="link">research</a>{' '}
					and <a href="/trace-grab/" class="link">trace-grab</a>
				</dd>
			</div>
			<div>
				<dt class="label">Open source</dt>
				<dd class="mt-1 text-slate">Code that runs inside your systems: trace-grab and our instrumentation SDKs.</dd>
			</div>
			<div>
				<dt class="label">Contact</dt>
				<dd class="mt-1"><a href={links.email} class="link text-ink">{site.email}</a></dd>
			</div>
			<div>
				<dt class="label">Elsewhere</dt>
				<dd class="mt-1 text-ink">
					<a href={links.linkedin} class="link" {...ext}>LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>{' '}
					and <a href={links.github} class="link" {...ext}>GitHub<span class="sr-only"> (opens in a new tab)</span></a>
				</dd>
			</div>
		</dl>
	</div>
</BaseLayout>
