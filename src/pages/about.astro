---
import ContactLink from '../components/ContactLink';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="About"
	description="Learn about Emet Labs and our work in runtime verification for agentic systems."
>
	<section class="mx-auto w-full max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
		<div class="grid gap-12 lg:grid-cols-12">
			<p class="text-xs font-medium uppercase tracking-[0.16em] text-black/50 lg:col-span-3">
				About
			</p>
			<div class="max-w-3xl lg:col-span-8">
				<h1 class="font-serif text-5xl font-light tracking-[-0.045em] sm:text-7xl">
					Building trust into agentic execution.
				</h1>
				<p class="mt-10 max-w-2xl text-xl leading-relaxed tracking-[-0.02em] text-black/65">
					Emet Labs is developing runtime verification infrastructure for graph-based
					agentic systems. More about our work and team will be shared soon.
				</p>
				<ContactLink class="mt-10 inline-flex text-sm font-medium underline hover:no-underline" />
			</div>
		</div>
	</section>
</BaseLayout>
