---
import { links, site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout
	title="Careers"
	description="Work with Emet Labs on runtime verification for AI agents."
	footerEmail={false}
>
	<header class="wrap pt-16 pb-24 sm:pt-24 sm:pb-32 lg:pt-28 lg:pb-40">
		<p class="meta text-dusk">Careers</p>
		<h1 class="mt-6 text-hero text-ink">Work With Us</h1>
		<p class="mt-8 max-w-2xl text-lede text-slate sm:mt-10">
			We work on runtime verification, formal methods, distributed systems and agent infrastructure. If
			checking what autonomous systems do interests you, write to us at{' '}
			<a href={links.email} class="link text-ink">{site.email}</a> and tell us what you have been building.
		</p>
	</header>
</BaseLayout>
