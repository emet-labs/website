---
import Button from '../components/Button.astro';
import PageHeader from '../components/PageHeader.astro';
import { links } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Careers" description="Careers at Emet Labs.">
	<PageHeader title="No open positions right now.">
		<p>
			If you work on runtime verification, formal methods or distributed systems, tell us what you
			have been building.
		</p>
		<div class="mt-10">
			<Button href={links.email}>Contact us</Button>
		</div>
	</PageHeader>
</BaseLayout>
