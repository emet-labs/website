---
import Button from '../components/Button.astro';
import PageHeader from '../components/PageHeader.astro';
import { links } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Careers" description="Careers at Emet Labs.">
	<PageHeader title="No open positions right now.">
		<p>
			We are glad to hear from people who care about runtime verification, formal methods,
			distributed systems, or making autonomous software accountable. If that describes you, write to
			us and tell us what you have been working on.
		</p>
		<div class="mt-10">
			<Button href={links.email}>Contact us</Button>
		</div>
	</PageHeader>
</BaseLayout>
