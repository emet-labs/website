---
import ContactSection from '../components/ContactSection.astro';
import PageHeader from '../components/PageHeader.astro';
import Rows from '../components/Rows.astro';
import Section from '../components/Section.astro';
import { links } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// Example taken from the public trace-grab README and documentation.
const command = 'npx @emetlabs/trace-grab grab ./langsmith-export --out ./corpus --from langsmith';

const before = `{
  "name": "modify_account",
  "inputs": {
    "account": "acct_1208",
    "actor": "alice@corp.com"
  }
}`;

const after = `{
  "name": "modify_account",
  "inputs": {
    "account": "TOK_4f1ab9c072",
    "actor": "TOK_88b0e13a5d"
  }
}`;

// Each claim is documented, with a command that verifies it, in the trace-grab README.
const claims = [
	'Contains no Emet Labs endpoint and has no upload command.',
	'No telemetry, analytics or update check.',
	'No postinstall script, and a single runtime dependency.',
	'Published to npm with signed build provenance.',
];

const steps = [
	{
		term: 'Export',
		body: 'Start from a trace export you already have: a LangSmith export, OTLP JSON, or span-shaped JSONL.',
	},
	{
		term: 'Run',
		body: 'trace-grab writes the tokenized bundle to a folder you name. The key that maps tokens back to your values stays on your machine.',
	},
	{
		term: 'Review',
		body: 'report.md lists every field the tool saw and what happened to it. If anything looks wrong, delete the folder.',
	},
	{
		term: 'Decide',
		body: 'If you are comfortable with the result, get in touch and send it by whatever means your organisation prefers.',
	},
];

const resources = [
	{ href: links.traceGrabDocs, label: 'Documentation' },
	{ href: links.traceGrabRepo, label: 'Source' },
	{ href: links.traceGrabNpm, label: 'npm' },
];
---

<BaseLayout
	title="trace-grab"
	description="trace-grab is an open-source tool for contributing agent traces to Emet Labs research without sharing their contents. It tokenizes trace exports on your own machine."
>
	<PageHeader title="trace-grab">
		<p>
			A command-line tool for contributing agent traces to our research without handing over their
			contents. It runs on your machine, replaces every string value with a stable token, and writes
			the result to a folder you choose. Nothing is sent anywhere unless you send it yourself.
		</p>
		<p class="mt-4 text-small text-dusk">Open source, Apache-2.0. Runs on Node 20 or later.</p>
	</PageHeader>

	<div class="wrap grid pb-16 sm:pb-24 lg:grid-cols-12">
		<div class="min-w-0 lg:col-span-9">
			<pre
				class="overflow-x-auto rounded-sm border border-line bg-mist px-5 py-4 text-small text-ink"
				aria-label="Example command"><code><span class="text-dusk select-none" aria-hidden="true">$ </span>{command}</code></pre>
			<ul class="mt-5 flex flex-wrap gap-x-8 gap-y-2 text-small font-medium">
				{
					resources.map(({ href, label }) => (
						<li>
							<a href={href} class="link" target="_blank" rel="noopener noreferrer">
								{label} ↗<span class="sr-only"> (opens in a new tab)</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<Section label="Why it exists">
		<div class="measure space-y-5 text-lede text-slate">
			<p>
				Verification is only as good as the behaviour it is tested against, so Sentinel is developed
				against real traces. Most teams cannot share raw traces: they contain customer data, internal
				tool names and sometimes regulated content.
			</p>
			<p>
				trace-grab lets you contribute the shape of your traces while keeping their content. The same
				value always becomes the same token, so relationships survive. The values do not.
			</p>
		</div>
	</Section>

	<Section label="What changes">
		<p class="statement">Equality is preserved. Identity is&nbsp;not.</p>
		<div class="mt-10 grid gap-6 md:grid-cols-2">
			<figure class="min-w-0">
				<figcaption class="label mb-3">Before</figcaption>
				<pre class="overflow-x-auto rounded-sm border border-line bg-mist px-5 py-4 text-small text-ink"><code>{before}</code></pre>
			</figure>
			<figure class="min-w-0">
				<figcaption class="label mb-3">After</figcaption>
				<pre class="overflow-x-auto rounded-sm border border-line bg-mist px-5 py-4 text-small text-ink"><code>{after}</code></pre>
			</figure>
		</div>
		<p class="measure mt-8 text-body text-slate">
			Numbers, booleans and timestamps pass through, as do field names and a short, documented list of
			structural fields such as tool and span names. Tokenization is pseudonymization, not
			anonymization; the{' '}
			<a href={links.traceGrabThreatModel} class="link text-ink" target="_blank" rel="noopener noreferrer">threat model<span class="sr-only"> (opens in a new tab)</span></a>{' '}
			sets out what it does and does not protect against.
		</p>
	</Section>

	<Section label="Claims you can check">
		<ul class="divide-y divide-line border-y border-line">
			{claims.map((claim) => <li class="py-5 text-body text-ink">{claim}</li>)}
		</ul>
		<p class="mt-6 text-small text-slate">
			The command that verifies each claim is listed in the{' '}
			<a href={`${links.traceGrabRepo}#what-it-does-not-do`} class="link text-ink" target="_blank" rel="noopener noreferrer">README<span class="sr-only"> (opens in a new tab)</span></a>.
		</p>
	</Section>

	<Section label="How to contribute">
		<Rows items={steps} ordered />
		<p class="mt-6 text-small text-slate">
			Read{' '}
			<a href={links.traceGrabTransfer} class="link text-ink" target="_blank" rel="noopener noreferrer">how transfer works<span class="sr-only"> (opens in a new tab)</span></a>{' '}
			before sending anything.
		</p>
	</Section>

	<ContactSection lead="If you run agents with tracing enabled and would like to contribute, write to us." />
</BaseLayout>
