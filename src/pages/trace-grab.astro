---
import JsonBlock from '../components/JsonBlock.astro';
import Section from '../components/Section.astro';
import { links, site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// Example taken from the public trace-grab README and documentation.
const command = `npx @emetlabs/trace-grab grab \\
    ./langsmith-export --out ./corpus \\
    --from langsmith`;

// One tool call before and after trace-grab. String values become stable
// tokens; the tool name, field names, numbers and booleans pass through, as
// the public README documents.
const before = {
	name: 'modify_account',
	inputs: { account: 'acct_1208', actor: 'alice@corp.com', amount: 860, notify: true },
};
const after = {
	name: 'modify_account',
	inputs: { account: 'TOK_4f1ab9c072', actor: 'TOK_88b0e13a5d', amount: 860, notify: true },
};
const changed = ['account', 'actor'];

// Each claim is documented in the trace-grab README, with a way to check it.
const claims = [
	'No Emet Labs endpoint and no upload command.',
	'No telemetry, analytics or update check.',
	'No postinstall script; one runtime dependency.',
	'Published to npm with signed build provenance.',
];

// Steps 1-3 happen on the contributor's machine; step 4 is their decision.
const steps = [
	{ label: 'Export', title: 'Start from a trace export', note: 'LangSmith, OTLP JSON or span-shaped JSONL.' },
	{ label: 'Run', title: 'Tokenize locally', note: 'The key back to your values stays on your machine.' },
	{ label: 'Review', title: 'Read report.md', note: 'Every field, and what happened to it.' },
	{ label: 'Decide', title: 'Send it, or delete it', note: 'Transfer happens only by a method you choose.' },
];

const resources = [
	{ href: links.traceGrabDocs, label: 'Documentation' },
	{ href: links.traceGrabRepo, label: 'Source' },
	{ href: links.traceGrabNpm, label: 'npm' },
];

const codeClass = 'overflow-x-auto rounded-sm border border-line bg-mist px-4 py-4 text-code text-ink sm:px-5 sm:text-small sm:leading-relaxed';
---

<BaseLayout
	title="trace-grab"
	description="trace-grab is an open-source tool for contributing agent traces to Emet Labs research without sharing their string values. It tokenizes trace exports on your own machine."
>
	<header class="wrap grid gap-14 pt-16 pb-8 sm:pt-24 lg:grid-cols-12 lg:gap-8 lg:pt-28 lg:pb-12">
		<div class="lg:col-span-6">
			<p class="meta text-dusk">Open source · Apache-2.0 · Node 20+</p>
			<h1 class="mt-6 text-hero text-ink">trace-grab</h1>
			<p class="mt-8 max-w-md text-lede text-slate sm:mt-10">
				Contribute the structure of your agent traces while their string values stay with you. It runs on
				your machine and replaces each value with a stable token.
			</p>
		</div>
		<div class="min-w-0 lg:col-span-6 lg:self-end">
			<pre class={codeClass}><code><span class="text-dusk select-none" aria-hidden="true">$ </span>{command}</code></pre>
			<ul class="mt-4 flex flex-wrap gap-x-8 text-small font-medium">
				{
					resources.map(({ href, label }) => (
						<li>
							<a href={href} class="link inline-flex min-h-11 items-center" target="_blank" rel="noopener noreferrer">
								{label} ↗<span class="sr-only"> (opens in a new tab)</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</header>

	<Section label="What changes">
		<p class="statement">Equality is preserved. Identity is&nbsp;not.</p>
		<div class="mt-10 grid gap-6 md:grid-cols-2">
			{
				(['before', 'after'] as const).map((side) => (
					<figure class="min-w-0">
						<figcaption class="meta mb-3 text-dusk">{side === 'before' ? 'Before' : 'After'}</figcaption>
						<JsonBlock value={side === 'before' ? before : after} mark={changed} tone={side} class={codeClass} />
					</figure>
				))
			}
		</div>
		<p class="measure mt-6 text-small text-slate">
			Numbers, booleans, timestamps, field names, and tool and span names pass through. Tokenization is
			pseudonymization, not anonymization: see the{' '}
			<a href={links.traceGrabThreatModel} class="link text-ink" target="_blank" rel="noopener noreferrer">threat model<span class="sr-only"> (opens in a new tab)</span></a>.
		</p>
	</Section>

	<Section label="How to contribute">
		<div class="grid gap-12 lg:grid-cols-4 lg:gap-8">
			{
				[
					{ name: 'On your machine', items: steps.slice(0, 3), start: 1, span: 'lg:col-span-3', list: 'sm:grid-cols-3', rule: 'border-ink' },
					{ name: 'Your decision', items: steps.slice(3), start: 4, span: '', list: '', rule: 'border-dashed border-line-strong' },
				].map(({ name, items, start, span, list, rule }) => (
					<div class={span}>
						<p class:list={['meta border-t pt-3 text-dusk', rule]}>{name}</p>
						<ol start={start} class:list={['mt-6 grid gap-10 lg:gap-8', list]}>
							{items.map(({ label, title, note }, i) => (
								<li>
									<p class="font-display text-headline text-dusk" aria-hidden="true">{start + i}</p>
									<h3 class="mt-3 text-subhead text-ink">
										<span class="sr-only">{label}: </span>{title}
									</h3>
									<p class="mt-2 text-small text-slate">{note}</p>
								</li>
							))}
						</ol>
					</div>
				))
			}
		</div>
		<p class="mt-12 text-small text-slate">
			To contribute, write to <a href={links.email} class="link text-ink">{site.email}</a>. Read{' '}
			<a href={links.traceGrabTransfer} class="link text-ink" target="_blank" rel="noopener noreferrer">how transfer works<span class="sr-only"> (opens in a new tab)</span></a>{' '}
			before sending anything.
		</p>
	</Section>

	<Section label="Claims you can check">
		<ul class="divide-y divide-line border-y border-line">
			{claims.map((claim) => <li class="py-4 text-lede text-ink">{claim}</li>)}
		</ul>
		<p class="mt-6 text-small text-slate">
			Each is documented, with a way to check it, in the{' '}
			<a href={`${links.traceGrabRepo}#what-it-does-not-do`} class="link text-ink" target="_blank" rel="noopener noreferrer">README<span class="sr-only"> (opens in a new tab)</span></a>.
		</p>
	</Section>

</BaseLayout>
