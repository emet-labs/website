---
import Button from '../components/Button.astro';
import ContactBand from '../components/ContactBand.astro';
import PageHeader from '../components/PageHeader.astro';
import { links } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// Example taken from the public trace-grab README and documentation.
const command = 'npx @emetlabs/trace-grab grab ./langsmith-export --out ./corpus --from langsmith';

const before = `{
  "name": "modify_account",
  "inputs": {
    "account": "acct_1208",
    "actor": "alice@corp.com"
  }
}`;

const after = `{
  "name": "modify_account",
  "inputs": {
    "account": "TOK_4f1ab9c072",
    "actor": "TOK_88b0e13a5d"
  }
}`;

// Each claim is documented, with a way to verify it, in the trace-grab README.
const claims = [
	'Contains no Emet Labs endpoint and has no upload command.',
	'No telemetry, analytics or update check.',
	'No postinstall script, and a single runtime dependency.',
	'Published to npm with signed build provenance.',
];

const steps = [
	{
		title: 'Export',
		body: 'Start from a trace export you already have: a LangSmith export, OTLP JSON, or span-shaped JSONL.',
	},
	{
		title: 'Run trace-grab',
		body: 'It writes the tokenized bundle to a folder you name. The key that maps tokens back to your values stays on your machine.',
	},
	{
		title: 'Review',
		body: 'report.md lists every field the tool saw and what happened to it. If anything looks wrong, delete the folder.',
	},
	{
		title: 'Decide',
		body: 'If you are comfortable with the result, get in touch and send it by whatever means your organisation prefers.',
	},
];
---

<BaseLayout
	title="trace-grab"
	description="trace-grab is an open-source tool for contributing agent traces to Emet Labs research without sharing their contents. It tokenizes trace exports on your own machine."
>
	<PageHeader eyebrow="Open source · Apache-2.0" title="trace-grab">
		<p>
			A command-line tool for contributing agent traces to our research without handing over their
			contents. It runs on your machine, replaces every string value with a stable token, and writes
			the result to a folder you choose. Nothing is sent anywhere unless you send it yourself.
		</p>
	</PageHeader>

	<section>
		<div class="wrap grid gap-10 py-16 sm:py-20 lg:grid-cols-12">
			<div class="lg:col-span-9 lg:col-start-4">
				<pre
					class="overflow-x-auto rounded-sm bg-ink px-5 py-4 text-small text-white"
					aria-label="Example command"><code><span class="text-haze select-none" aria-hidden="true">$ </span>{command}</code></pre>
				<div class="mt-6 flex flex-wrap gap-3">
					<Button href={links.traceGrabDocs} external>Documentation</Button>
					<Button href={links.traceGrabRepo} variant="secondary" external>Source on GitHub</Button>
					<Button href={links.traceGrabNpm} variant="secondary" external>npm</Button>
				</div>
			</div>
		</div>
	</section>

	<section class="border-t border-line">
		<div class="wrap grid gap-10 py-20 sm:py-28 lg:grid-cols-12">
			<p class="eyebrow lg:col-span-3 lg:pt-3">Why it exists</p>
			<div class="space-y-6 text-lede text-slate lg:col-span-7">
				<p>
					Verification is only as good as the behaviour it is tested against, and Sentinel is developed
					against real traces. Most teams cannot share raw traces: they contain customer data, internal
					tool names and sometimes regulated content.
				</p>
				<p>
					trace-grab lets you contribute the <em>shape</em> of your traces while keeping their
					content. The same value always becomes the same token, so relationships survive. The values
					themselves do not.
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-line bg-mist">
		<div class="wrap py-20 sm:py-28">
			<div class="grid gap-8 lg:grid-cols-12">
				<p class="eyebrow lg:col-span-3 lg:pt-3">What changes</p>
				<h2 class="max-w-3xl text-headline text-ink lg:col-span-9">
					Equality is preserved. Identity is&nbsp;not.
				</h2>
			</div>
			<div class="mt-12 grid gap-4 md:grid-cols-2 lg:ml-[25%]">
				<figure>
					<figcaption class="eyebrow mb-3">Before</figcaption>
					<pre class="overflow-x-auto rounded-sm border border-line bg-paper px-5 py-4 text-small text-ink"><code>{before}</code></pre>
				</figure>
				<figure>
					<figcaption class="eyebrow mb-3">After</figcaption>
					<pre class="overflow-x-auto rounded-sm border border-line bg-paper px-5 py-4 text-small text-ink"><code>{after}</code></pre>
				</figure>
			</div>
			<p class="measure mt-8 text-small text-slate lg:ml-[25%]">
				Numbers, booleans and timestamps pass through, as do field names and a short, documented list
				of structural fields such as tool and span names. Tokenization is pseudonymization, not
				anonymization; the <a href={links.traceGrabThreatModel} class="link text-ink" target="_blank" rel="noopener noreferrer">threat model<span class="sr-only"> (opens in a new tab)</span></a>
				sets out what it does and does not protect against.
			</p>
		</div>
	</section>

	<section class="border-t border-line">
		<div class="wrap grid gap-10 py-20 sm:py-28 lg:grid-cols-12">
			<div class="lg:col-span-3">
				<p class="eyebrow lg:pt-3">Checkable, not reassuring</p>
			</div>
			<div class="lg:col-span-9">
				<h2 class="max-w-3xl text-headline text-ink">Each claim comes with a way to verify&nbsp;it.</h2>
				<ul class="mt-10 divide-y divide-line border-y border-line">
					{
						claims.map((claim) => (
							<li class="flex gap-4 py-5 text-body text-ink">
								<span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-silver" aria-hidden="true" />
								{claim}
							</li>
						))
					}
				</ul>
				<p class="mt-6 text-small text-slate">
					The commands that verify each claim are in the
					<a href={`${links.traceGrabRepo}#what-it-does-not-do`} class="link text-ink" target="_blank" rel="noopener noreferrer">README<span class="sr-only"> (opens in a new tab)</span></a>.
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-line">
		<div class="wrap grid gap-10 py-20 sm:py-28 lg:grid-cols-12">
			<p class="eyebrow lg:col-span-3 lg:pt-3">Contributing</p>
			<ol class="grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:col-span-9 lg:grid-cols-4">
				{
					steps.map(({ title, body }, i) => (
						<li class="bg-paper p-7">
							<p class="font-display text-subhead text-silver" aria-hidden="true">{i + 1}</p>
							<h3 class="mt-4 text-subhead text-ink">{title}</h3>
							<p class="mt-3 text-small text-slate">{body}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<ContactBand title="Run agents with tracing enabled? Your traces could help.">
		<p>
			Read <a href={links.traceGrabTransfer} class="underline decoration-white/40 hover:decoration-white" target="_blank" rel="noopener noreferrer">how transfer works<span class="sr-only"> (opens in a new tab)</span></a>
			before sending anything.
		</p>
	</ContactBand>
</BaseLayout>
