---
import PageHeader from '../components/PageHeader.astro';
import { links, site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Legal" description="Licensing and legal information for Emet Labs.">
	<PageHeader title="Legal" />

	<div class="wrap pb-20 sm:pb-28">
		<div class="prose-emet">
			<h2>Open-source software</h2>
			<p>Some Emet Labs software is published as open source under its own licence:</p>
			<ul>
				<li>
					<a href={links.traceGrabRepo} target="_blank" rel="noopener noreferrer">trace-grab<span class="sr-only"> (opens in a new tab)</span></a>{' '}
					is licensed under the Apache License 2.0.
				</li>
				<li>
					The Sentinel instrumentation SDKs published on{' '}
					<a href={links.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a>{' '}
					are licensed under the Mozilla Public License 2.0.
				</li>
			</ul>
			<p>Each repository’s licence file is authoritative.</p>

			<h2>This website</h2>
			<p>
				Content on this website is © {site.name}. The Forum and Public Sans typefaces are used under
				the SIL Open Font License 1.1, and their licence files are published with the fonts.
			</p>

			<h2>Contact</h2>
			<p>For legal enquiries, contact <a href={links.email}>{site.email}</a>.</p>
		</div>
	</div>
</BaseLayout>
