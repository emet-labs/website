---
/**
 * A worked example of the idea behind Emet Labs' work, deliberately generic:
 * one rule, a short record of events from three systems, and the three answers
 * a verifier can honestly give. It illustrates the problem, not any product's
 * internals, and is labelled as an example.
 *
 * Progressive enhancement: without JavaScript every scenario is listed in turn.
 * With it, the buttons switch between them and the answer is announced politely.
 */
type EventId = 'approval' | 'refund' | 'ledger';

const events: Record<EventId, { system: string; event: string }> = {
	approval: { system: 'Approvals', event: 'Request approved' },
	refund: { system: 'Payments', event: 'Refund issued' },
	ledger: { system: 'Ledger', event: 'Entry recorded' },
};

const scenarios: {
	id: string;
	label: string;
	order: EventId[];
	missing?: EventId;
	verdict: string;
	note: string;
}[] = [
	{
		id: 'holds',
		label: 'Approved first',
		order: ['approval', 'refund', 'ledger'],
		verdict: 'Holds.',
		note: 'The approval is recorded before the refund.',
	},
	{
		id: 'violated',
		label: 'Refunded first',
		order: ['refund', 'approval', 'ledger'],
		verdict: 'Violated.',
		note: 'The refund went out before any approval.',
	},
	{
		id: 'unknown',
		label: 'Approvals silent',
		order: ['approval', 'refund', 'ledger'],
		missing: 'approval',
		verdict: 'Not yet known.',
		note: 'The approvals system sent nothing, so neither answer is supported.',
	},
];
---

<figure class="rounded-sm border border-line bg-paper" data-rule-example aria-label="Example: checking one rule against a record">
	<div class="flex items-baseline justify-between gap-4 border-b border-line px-5 py-4 sm:px-6">
		<div>
			<p class="text-label text-dusk">Rule</p>
			<p class="mt-1 text-body text-ink">A refund is issued only after an approval.</p>
		</div>
		<p class="shrink-0 text-label text-dusk">Example</p>
	</div>

	<div class="border-b border-line px-5 py-3 sm:px-6" data-controls hidden>
		<div class="flex flex-wrap gap-2" role="group" aria-label="What the record shows">
			{
				scenarios.map((s, i) => (
					<button
						type="button"
						data-scenario={s.id}
						aria-pressed={i === 0 ? 'true' : 'false'}
						class="min-h-10 rounded-sm px-3 text-small text-slate transition-colors hover:bg-mist hover:text-ink aria-pressed:bg-ink aria-pressed:text-white"
					>
						{s.label}
					</button>
				))
			}
		</div>
	</div>

	<div aria-live="polite" data-panels>
		{
			scenarios.map((s) => (
				<div data-panel={s.id} class="grid gap-8 px-5 py-6 sm:grid-cols-2 sm:px-6 [&+&]:border-t [&+&]:border-line">
					<div>
						<p class="text-label text-dusk">
							Record<span data-nojs-title>: {s.label.toLowerCase()}</span>
						</p>
						<ol class="mt-3 ml-1.5 border-l border-line">
							{s.order.map((id) => {
								const missing = s.missing === id;
								return (
									<li class="relative py-2.5 pl-5">
										<span
											aria-hidden="true"
											class:list={[
												'absolute top-[1.05rem] -left-[5.5px] size-2.5 rounded-full',
												missing ? 'border border-dashed border-dusk bg-paper' : 'bg-ink',
											]}
										/>
										<span class="block text-label text-dusk">{events[id].system}</span>
										<span class:list={['block text-small', missing ? 'text-dusk italic' : 'text-ink']}>
											{missing ? 'Nothing reported' : events[id].event}
										</span>
									</li>
								);
							})}
						</ol>
					</div>
					<div class="sm:border-l sm:border-line sm:pl-6">
						<p class="text-label text-dusk">Answer</p>
						<p class="mt-2 font-display text-headline text-ink">{s.verdict}</p>
						<p class="mt-3 text-small text-slate">{s.note}</p>
					</div>
				</div>
			))
		}
	</div>
</figure>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-rule-example]')) {
		const controls = root.querySelector<HTMLElement>('[data-controls]');
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-scenario]')];
		const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
		if (!controls || !buttons.length) continue;

		const show = (id: string, animate: boolean) => {
			for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.scenario === id));
			for (const p of panels) {
				const active = p.dataset.panel === id;
				p.hidden = !active;
				p.classList.toggle('fade-in', active && animate);
			}
		};

		controls.hidden = false;
		for (const t of root.querySelectorAll<HTMLElement>('[data-nojs-title]')) t.hidden = true;
		show(buttons[0].dataset.scenario!, false);
		for (const b of buttons) b.addEventListener('click', () => show(b.dataset.scenario!, true));
	}
</script>
