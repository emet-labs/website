---
const year = new Date().getFullYear();

const pageLinks = [
	{ label: 'Careers', href: '/careers' },
	{ label: 'Legal', href: '/legal' },
	{ label: 'Privacy', href: '/privacy' },
];
---

<footer id="footer" class="border-t border-black/10">
	<div
		class="mx-auto flex max-w-7xl flex-col gap-8 px-6 py-8 text-sm sm:flex-row sm:items-end sm:justify-between lg:px-10"
	>
		<div>
			<a href="/" class="font-medium tracking-[-0.02em]">Emet Labs.</a>
			<p class="mt-2 text-black/50">© {year} Emet Labs. All rights reserved.</p>
		</div>

		<nav class="flex flex-wrap gap-x-6 gap-y-3 text-black/60" aria-label="Footer navigation">
			<a class="transition-colors hover:text-black" href="/about">About</a>
			<a class="transition-colors hover:text-black" href="/blog">Blog</a>
			<a class="transition-colors hover:text-black" href="https://docs.emetlabs.ai" target="_blank" rel="noopener noreferrer">Docs</a>
			{pageLinks.map(({ label, href }) => (
				<a class="transition-colors hover:text-black" href={href}>{label}</a>
			))}
			<a
				class="transition-colors hover:text-black"
				href="https://www.linkedin.com/company/emetlabsai/"
				target="_blank"
				rel="noopener noreferrer"
			>
				LinkedIn
			</a>
			<a class="transition-colors hover:text-black" href="mailto:founders@emetlabs.ai" target="_blank" rel="noopener noreferrer">
				Contact
			</a>
		</nav>
	</div>
</footer>
