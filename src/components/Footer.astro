---
import { footerNav, links, site } from '../config/site';
import Logo from './Logo.astro';

interface Props {
	/** Show the email address. Pages that already set it prominently turn this off. */
	email?: boolean;
}

const { email = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-paper">
	<div class="wrap">
		<div class="grid gap-12 border-t border-line pt-12 pb-10 md:grid-cols-12 md:gap-8">
			<div class="md:col-span-6">
				<a href="/" aria-label="Emet Labs home" class="inline-block py-1">
					<Logo class="h-10 w-auto" loading="lazy" />
				</a>
				<p class="mt-5 max-w-xs text-small text-slate">Runtime verification across services, applications and agents.</p>
				{
					email && (
						<a href={links.email} class="link mt-6 inline-flex min-h-11 items-center text-small text-ink">
							{site.email}
						</a>
					)
				}
			</div>
			<nav aria-label="Footer" class="grid grid-cols-2 gap-x-8 text-small md:col-span-5 md:col-start-8">
				{
					footerNav.map((group) => (
						<ul class="flex flex-col">
							{group.map(({ href, label, external }) => (
								<li>
									<a
										href={href}
										target={external ? '_blank' : undefined}
										rel={external ? 'noopener noreferrer' : undefined}
										class="inline-flex min-h-11 items-center text-slate transition-colors hover:text-ink md:min-h-10"
									>
										{label}
										{external && <span class="sr-only"> (opens in a new tab)</span>}
									</a>
								</li>
							))}
						</ul>
					))
				}
			</nav>
		</div>
		<div class="border-t border-line pt-5 pb-8 text-small text-dusk">
			<p>© {year} {site.name}</p>
		</div>
	</div>
</footer>
