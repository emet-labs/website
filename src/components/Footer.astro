---
import { footerNav, site } from '../config/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-paper">
	<div class="wrap grid gap-12 py-14 md:grid-cols-12 md:py-20">
		<div class="md:col-span-5">
			<a href="/" aria-label="Emet Labs home" class="inline-block">
				<Logo class="h-14 w-auto" loading="lazy" />
			</a>
			<p class="mt-6 max-w-xs text-small text-slate">
				Verification infrastructure for AI agents.
			</p>
		</div>

		<nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7">
			{
				footerNav.map(({ heading, items }) => (
					<div>
						<h2 class="label">{heading}</h2>
						<ul class="mt-3 space-y-0.5 text-small">
							{items.map(({ href, label, external }) => (
								<li>
									<a
										href={href}
										target={external ? '_blank' : undefined}
										rel={external ? 'noopener noreferrer' : undefined}
										class="inline-block py-1.5 text-slate transition-colors hover:text-ink"
									>
										{label}
										{external && <span class="sr-only">(opens in a new tab)</span>}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</nav>
	</div>

	<div class="wrap">
		<p class="border-t border-line py-6 text-small text-dusk">© {year} {site.name}. All rights reserved.</p>
	</div>
</footer>
