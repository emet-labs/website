---
/**
 * Opening block for interior pages: title and optional lede (default slot).
 * The current page is already marked in the navigation, so there is no eyebrow.
 */
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<header class="wrap grid gap-8 pt-16 pb-16 sm:pt-24 sm:pb-20 lg:grid-cols-12 lg:pt-28">
	<div class="lg:col-span-9">
		<h1 class="text-title text-ink">{title}</h1>
		{
			Astro.slots.has('default') && (
				<div class="measure mt-6 text-lede text-slate">
					<slot />
				</div>
			)
		}
	</div>
</header>
