---
/**
 * Opening block for interior pages: an optional eyebrow in the instrument voice,
 * the title, and an optional lede (default slot).
 */
interface Props {
	title: string;
	eyebrow?: string;
}

const { title, eyebrow } = Astro.props;
---

<header class="wrap pt-14 pb-12 sm:pt-20 sm:pb-16 lg:pt-24">
	{eyebrow && <p class="meta mb-6 text-dusk">{eyebrow}</p>}
	<h1 class="max-w-4xl text-display text-ink">{title}</h1>
	{
		Astro.slots.has('default') && (
			<div class="mt-8 max-w-2xl text-lede text-slate">
				<slot />
			</div>
		)
	}
</header>
