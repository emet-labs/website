---
/**
 * A short sequence of steps on one hairline: horizontal from md up (unless
 * `vertical`), vertical on phones. Each step is a small label, a display-set
 * title and an optional one-line note.
 */
interface Step {
	label: string;
	title: string;
	note?: string;
}

interface Props {
	steps: Step[];
	vertical?: boolean;
	class?: string;
}

const { steps, vertical = false, class: className } = Astro.props;
const cols: Record<number, string> = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'md:grid-cols-4' };
const horizontal = !vertical;
---

<ol
	class:list={[
		'ml-1 grid gap-10 border-l border-line pl-6',
		horizontal && ['md:ml-0 md:gap-8 md:border-t md:border-l-0 md:pl-0', cols[steps.length] ?? 'md:grid-cols-3'],
		className,
	]}
>
	{
		steps.map(({ label, title, note }, i) => (
			<li class:list={['relative', horizontal && 'md:pt-8']}>
				<span
					aria-hidden="true"
					class:list={[
						'absolute top-1 -left-[1.82rem] size-2 rounded-full',
						horizontal && 'md:top-0 md:left-0 md:-translate-y-1/2',
						i === 0 ? 'bg-ink' : 'bg-silver',
					]}
				/>
				<p class="label">{label}</p>
				<h3 class="mt-2 text-subhead text-ink">{title}</h3>
				{note && <p class="mt-2 max-w-xs text-small text-slate">{note}</p>}
			</li>
		))
	}
</ol>
