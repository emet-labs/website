---
/**
 * The site's one section primitive. On wide screens the section name hangs in the
 * left margin (columns 1–3) and content sits on a shared axis (columns 4–12), so
 * every page lines up on the same grid. Space, not rules, separates sections.
 *
 * The label is the section's h2, so headings stay one size per level and name
 * each section plainly. Larger statements inside a section are display-set
 * paragraphs (`.statement`), not headings.
 *
 * `tone="ink"` is the one full-bleed brand-colour chapter; use it at most once a page.
 */
interface Props {
	label?: string;
	tone?: 'paper' | 'ink';
	id?: string;
	class?: string;
}

const { label, tone = 'paper', id, class: className } = Astro.props;
const ink = tone === 'ink';
---

<section id={id} class:list={[ink && 'tone-ink bg-ink text-white', className]}>
	<div class:list={['wrap grid gap-6 lg:grid-cols-12 lg:gap-8', ink ? 'py-20 sm:py-32' : 'py-14 sm:py-20']}>
		{label && <h2 class:list={['label lg:col-span-3 lg:pt-1.5', ink && 'text-haze']}>{label}</h2>}
		<div class="min-w-0 lg:col-span-9 lg:col-start-4">
			<slot />
		</div>
	</div>
</section>
