---
import ContactLink from './ContactLink';

const pathname = Astro.url.pathname;

const navItems = [
	{ href: '/sentinel', label: 'Sentinel' },
	{ href: '/trace-bounty', label: 'Trace Bounty' },
	{ href: '/about', label: 'About' },
	{ href: '/blog', label: 'Blog' },
];
---

<header class="border-b border-black/10">
	<div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-10">
		<a
			href="/"
			class="text-lg font-medium tracking-[-0.03em]"
			aria-label="Emet Labs home"
		>
			Emet Labs.
		</a>

		<nav class="flex items-center gap-5 text-sm sm:gap-8" aria-label="Primary navigation">
			{
				navItems.map(({ href, label }) => (
					<a
						href={href}
						class:list={[
							'transition-opacity hover:opacity-50',
							pathname.startsWith(href) && 'underline',
						]}
						aria-current={pathname.startsWith(href) ? 'page' : undefined}
					>
						{label}
					</a>
				))
			}
			<ContactLink
				class="hidden rounded-full border border-black px-4 py-2 transition-colors hover:bg-black hover:text-white sm:inline-flex"
			/>
		</nav>
	</div>
</header>
