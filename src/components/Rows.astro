---
/**
 * A ruled list of term / description pairs. Used for principles, status, steps.
 * `ordered` renders an <ol> (for sequences); otherwise a <dl>.
 */
interface Row {
	term: string;
	body: string;
	href?: string;
	linkLabel?: string;
}

interface Props {
	items: Row[];
	ordered?: boolean;
	class?: string;
}

const { items, ordered = false, class: className } = Astro.props;
const isExternal = (href: string) => href.startsWith('http');
const rowClass = 'grid gap-2 py-6 md:grid-cols-9 md:gap-8';
const termClass = 'font-display text-subhead text-ink md:col-span-3';
const bodyClass = 'text-body text-slate md:col-span-6';
---

{
	ordered ? (
		<ol class:list={['divide-y divide-line border-y border-line', className]}>
			{items.map(({ term, body }, i) => (
				<li class={rowClass}>
					<h3 class={termClass}>
						<span class="mr-3 font-sans text-label text-dusk tabular-nums">{i + 1}</span>
						{term}
					</h3>
					<p class={bodyClass}>{body}</p>
				</li>
			))}
		</ol>
	) : (
		<dl class:list={['divide-y divide-line border-y border-line', className]}>
			{items.map(({ term, body, href, linkLabel }) => (
				<div class={rowClass}>
					<dt class={termClass}>{term}</dt>
					<dd class={bodyClass}>
						{body}
						{href && (
							<>
								{' '}
								<a
									href={href}
									class="link whitespace-nowrap text-ink"
									target={isExternal(href) ? '_blank' : undefined}
									rel={isExternal(href) ? 'noopener noreferrer' : undefined}
								>
									{linkLabel ?? 'More'}
									{isExternal(href) ? ' ↗' : ' →'}
									{isExternal(href) && <span class="sr-only"> (opens in a new tab)</span>}
								</a>
							</>
						)}
					</dd>
				</div>
			))}
		</dl>
	)
}
