---
/**
 * A footnote mark: superscript numbers that link to the reference list on the
 * Research page. Pass one or more reference ids from src/config/references.ts.
 * `base` is the page that holds the list, for use outside the Research page.
 */
import { refNumber } from '../config/references';

interface Props {
	ids: string[];
	base?: string;
}

const { ids, base = '' } = Astro.props;
---

<sup class="ml-0.5 text-[0.7em] leading-none whitespace-nowrap">{
	ids.map((id, i) => (
		<>
			{i > 0 && ','}
			<a href={`${base}#ref-${refNumber(id)}`} class="link font-medium text-dusk" aria-label={`Reference ${refNumber(id)}`}>{refNumber(id)}</a>
		</>
	))
}</sup>
