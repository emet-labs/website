---
/**
 * Font loading.
 *
 * - Satoshi (body/UI) is self-hosted under its Fontshare licence and preloaded.
 * - Minerva Modern (display) is loaded from the Adobe Fonts web project, when one
 *   is configured. Preconnecting to both Typekit hosts lets the stylesheet and
 *   font files start downloading early; the kit's own font-display setting
 *   (use "fallback" in the Adobe Fonts project) controls fallback behaviour.
 */
import { adobeFontsKitId } from '../config/site';
---

<link
	rel="preload"
	as="font"
	type="font/woff2"
	href="/fonts/satoshi/Satoshi-Variable.woff2"
	crossorigin
/>
{
	adobeFontsKitId && (
		<>
			<link rel="preconnect" href="https://use.typekit.net" crossorigin />
			<link rel="preconnect" href="https://p.typekit.net" />
			<link rel="stylesheet" href={`https://use.typekit.net/${adobeFontsKitId}.css`} />
		</>
	)
}
