---
import { links } from '../config/site';
import Button from './Button.astro';
import Motif from './Motif.astro';

interface Props {
	title?: string;
}

const { title = 'Building agents that act in the real world? We would like to hear from you.' } = Astro.props;
---

<section class="on-ink relative overflow-hidden bg-ink text-white">
	<Motif class="pointer-events-none absolute -right-10 -bottom-6 hidden h-64 text-white/25 md:block" />
	<div class="wrap relative grid gap-10 py-20 sm:py-24 lg:grid-cols-12 lg:items-end">
		<h2 class="text-headline lg:col-span-8">{title}</h2>
		<div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
			<Button href={links.email} variant="inverse">Get in touch</Button>
		</div>
		{
			Astro.slots.has('default') && (
				<div class="measure text-small text-haze lg:col-span-12">
					<slot />
				</div>
			)
		}
	</div>
</section>
