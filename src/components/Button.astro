---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary';

interface Props extends HTMLAttributes<'a'> {
	href: string;
	variant?: Variant;
	external?: boolean;
}

const { href, variant = 'primary', external = false, class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
	primary: 'bg-ink text-white hover:bg-ink-deep',
};
---

<a
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	class:list={[
		'inline-flex min-h-11 items-center justify-center rounded-sm px-5 text-small font-medium transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_18px_-8px_rgb(26_28_39/0.55)] active:translate-y-0 active:shadow-none',
		variants[variant],
		className,
	]}
	{...rest}
>
	<slot />
	{external && <span class="sr-only"> (opens in a new tab)</span>}
</a>
