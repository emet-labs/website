---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'inverse' | 'inverse-outline';

interface Props extends HTMLAttributes<'a'> {
	href: string;
	variant?: Variant;
	external?: boolean;
}

const { href, variant = 'primary', external = false, class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
	primary: 'bg-ink text-white hover:bg-ink-deep',
	secondary: 'border border-line-strong text-ink hover:border-ink',
	inverse: 'bg-white text-ink hover:bg-mist',
	'inverse-outline': 'border border-white/40 text-white hover:border-white',
};
---

<a
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	class:list={[
		'group inline-flex min-h-11 items-center justify-center gap-2 rounded-sm px-5 text-small font-medium transition-colors duration-200',
		variants[variant],
		className,
	]}
	{...rest}
>
	<slot />
	<span
		aria-hidden="true"
		class="transition-transform duration-200 ease-out group-hover:translate-x-0.5"
	>
		{external ? '↗' : '→'}
	</span>
	{external && <span class="sr-only">(opens in a new tab)</span>}
</a>
